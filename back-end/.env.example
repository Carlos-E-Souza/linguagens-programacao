# Configuração do servidor. Copie para .env e ajuste:
#   cp .env.example .env
#
# Durações exigem unidade explícita (30s, 24h); um número sem unidade é
# rejeitado na inicialização.

# Endereço de escuta HTTP.
SERVER_ADDRESS=:8080

# Caminho do arquivo do banco SQLite.
DATABASE_PATH=./chat.db

# Chave HS256 usada para assinar os tokens de acesso JWT.
# Obrigatória fora do modo dev; troque antes de publicar em qualquer lugar.
JWT_SECRET=change-me

# Defina como true para rodar localmente sem JWT_SECRET.
DEV_MODE=false

# Número de goroutines que gravam mensagens no banco.
PERSISTENCE_WORKERS=4

# Cadência do heartbeat do WebSocket e prazo de resposta ao ping.
PING_INTERVAL=30s
PONG_TIMEOUT=60s

# Validade do JWT.
TOKEN_EXPIRY=24h

# Buffer do canal de saída de cada conexão.
CLIENT_QUEUE_SIZE=256

# Buffer da fila de persistência.
PERSISTENCE_QUEUE_SIZE=4096

# Tamanho máximo do corpo de uma mensagem, em caracteres.
MESSAGE_LIMIT_CHARS=4000

# Endereço separado para o servidor de depuração net/http/pprof.
# Deixe vazio para desativar. Só é permitido com DEV_MODE=true, porque
# os endpoints do profiler não têm autenticação e expõem detalhes internos.
PPROF_ADDRESS=
