# Server configuration. Copy to .env and adjust:
#   cp .env.example .env
#
# Durations require an explicit unit (30s, 24h); a bare number is
# rejected at startup.

# HTTP listen address.
SERVER_ADDRESS=:8080

# SQLite database file path.
DATABASE_PATH=./chat.db

# HS256 key used to sign the JWT access tokens.
# Required outside dev mode; change it before deploying anywhere.
JWT_SECRET=change-me

# Set to true to run locally without a JWT_SECRET.
DEV_MODE=false

# Number of goroutines that write messages to the database.
PERSISTENCE_WORKERS=4

# WebSocket heartbeat cadence and ping deadline.
PING_INTERVAL=30s
PONG_TIMEOUT=60s

# JWT validity window.
TOKEN_EXPIRY=24h

# Per-connection outgoing channel buffer.
CLIENT_QUEUE_SIZE=256

# Persistence queue buffer.
PERSISTENCE_QUEUE_SIZE=4096
